# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — it must never be committed.

# MongoDB connection string (MongoDB Atlas or local mongod)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# Port the API/socket server listens on
PORT=8000

# Comma-separated list of origins allowed to call this API.
# 3000 is the Vite dev server, 4173 is `npm run preview`.
# An entry may contain "*" to match one hostname segment, which covers the
# per-build URLs a host like Vercel generates:
#   https://myapp-*-myteam.vercel.app
# Add your deployed frontend URL here too.
CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# Signing key for access tokens. Use a different value in every environment.
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
