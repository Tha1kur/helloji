# Copy to `frontend/.env` and adjust.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the backend API + socket server.
VITE_SERVER_URL=http://localhost:8000

# Optional TURN relay. Without it, calls fail between peers behind symmetric
# NAT or restrictive firewalls. Free tiers: Metered, Twilio, or self-host coturn.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
